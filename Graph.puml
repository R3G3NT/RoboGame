@startuml classes
left to right direction
skinparam linetype ortho

class Robot {
    - name : std::string
    - type : Type
    - hp : int
    - max_hp : int
    - attack_power : int
    - speed : int
    - energy : int
    - max_energy : int
    - exp : int
    - exp_for_next_rank : int
    - rank : int
    + x : int
    + y : int
    __
    + Robot(name : std::string, type : Type,
            hp : int, attack : int,
            energy : int, speed : int)
    + GetName() : std::string
    + GetType() : Type
    + GetHp() : int
    + GetMaxHp() : int
    + GetAttackPower() : int
    + GetSpeed() : int
    + GetEnergy() : int
    + GetMaxEnergy() : int
    + GetExp() : int
    + GetExpToNextRank() : int
    + GetRank() : int
    + ChangeHp(amount : int) : void
    + ChangeEnergy(amount : int) : void
    + ChangeSpeed(amount : int) : void
    + AddExp(amount : int) : void
    + Interact(other : Robot*) : void
    - CheckRankUp() : void
}

enum "Robot::Type" as RobotType <<enumeration>> {
    Player
    Friend
    Enemy
}

class Cell {
    - terrain : Terrain
    - visible : bool
    - robot : Robot*
    __
    + Cell(p_terrain : Terrain)
    + GetTerrain() : Terrain
    + IsWalkable() : bool
    + IsVisible() : bool
    + SetTerrain(terrain : Terrain) : void
    + SetVisible(visible : bool) : void
    + GetRobot() : Robot*
    + HasRobot() : bool
    + SetRobot(other : Robot*) : void
    + RemoveRobot() : void
}

enum "Cell::Terrain" as CellTerrain <<enumeration>> {
    Floor
    Wall
    Swamp
}

class Field {
    - width : int
    - height : int
    - grid : std::vector<std::vector<Cell>>
    __
    + Field(width : int, height : int)
    + GetWidth() : int
    + GetHeight() : int
    + GetCell(x : int, y : int) : Cell&
    + IsWalkable(x : int, y : int) : bool
    + ClearVisibility() : void
}

class GameEngine {
    - robots : std::vector<std::shared_ptr<Robot>>
    - player_ptr : Robot*
    - current_move : int
    + field : Field
    __
    + GameEngine(width : int, height : int)
    + SpawnRobot(robot : std::shared_ptr<Robot>,
                 x : int, y : int) : void
    + MoveRobot(from_x : int, from_y : int,
                dx : int, dy : int) : bool
    + UpdateVisibility() : void
    + LoadLevel(level : std::vector<std::string>&) : void
    + Run() : void
    - HandlePlayerTurn() : void
    - HandleEnemiesTurn() : void
    - CleanDeadRobots() : void
}

class Visualizer <<static utility>> {
    + {static} InitScreen() : void
    + {static} Shutdown() : void
    + {static} Draw(field : Field&) : void
    + {static} DrawStatus(robot : Robot*) : void
    + {static} UpdateScreen(field : Field&, current_move : int,
                            player_ptr : Robot*) : void
}

enum Config <<enumeration>> {
    AttackCost
    HealCost
    HealAmount
    VisibilityRadius
    EnergyPerTurn
    EnergyPerWait
    PlayerHp
    PlayerAttack
    PlayerEnergy
    PlayerSpeed
    FriendHp
    FriendAttack
    FriendEnergy
    FriendSpeed
    EnemyHp
    EnemyAttack
    EnemyEnergy
    EnemySpeed
}

GameEngine *-- Field        : owns
GameEngine o-- Robot        : manages
Field      *-- Cell         : contains
Cell       --> Robot        : holds ptr
Robot      --> RobotType    : uses
Cell       --> CellTerrain  : uses 
Robot      ..> Config       : uses
GameEngine ..> Config       : uses
GameEngine ..> Visualizer   : uses

@enduml